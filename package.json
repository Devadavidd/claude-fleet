{
  "name": "claude-fleet-dashboard",
  "version": "0.1.0",
  "description": "Local read-only web dashboard for observing all live Claude Code sessions (fleet view + per-session tool-call timeline)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/server/main.js",
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "concurrently \"tsc -p tsconfig.server.json -w\" \"node --watch dist/server/main.js\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json",
    "test": "npm run typecheck && npm run build:server && node --test test/server/ && vitest run --config client/vitest.config.ts"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^20.19.43",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
